# Variables publiques Supabase (exposées au bundle Next.js).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variables serveur — JAMAIS exposées au client.
# Service role : utilisé UNIQUEMENT dans les tests E2E (helper auth + lecture audit_logs).
SUPABASE_SERVICE_ROLE_KEY=

# Clés NIR : utilisées uniquement par l'Edge Function Deno (supabase secrets set ...).
# Listées ici pour référence ; ne jamais les charger côté apps/web.
# APP_NIR_ENCRYPTION_KEY=
# APP_NIR_SEARCH_KEY=

# ─── Phase 1.5 — RGPD compliance (server-only) ───
#
# Server Actions / route handlers seulement. JAMAIS exposer côté client
# (pas de préfixe NEXT_PUBLIC_).

# JWT portail patient (D-10) — HS256, 32 bytes minimum.
# Signe les request_token (patient_data_request), validité 30 jours.
# Générer : openssl rand -base64 32
# Distinct de APP_NIR_ENCRYPTION_KEY (réutilisation = élargissement de surface).
APP_LEGAL_TOKEN_SECRET=

# Salt anonymisation art. 17 RGPD — utilisé par RPC rgpd_anonymize_patient.
# Générer : openssl rand -base64 32
# JAMAIS rotation sans plan migration (hash NIR anonymisés deviendraient incohérents).
APP_ANONYMIZATION_SALT=
