# Supabase (local: récupéré après `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement applicatif (NIR, notes médicales) — AES-256-GCM
APP_ENCRYPTION_KEY=

# SMS (Twilio ou OVH SMS Pro)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OSRM auto-hébergé
OSRM_BASE_URL=http://localhost:5000

# Microservice optimizer (OR-Tools)
OPTIMIZER_BASE_URL=http://localhost:8080

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
