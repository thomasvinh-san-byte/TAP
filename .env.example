# Supabase (local: récupéré après `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Chiffrement applicatif (NIR, notes médicales) — AES-256-GCM
APP_ENCRYPTION_KEY=

# Edge Function NIR — clés AES-256 + HMAC-SHA256 (32 bytes base64 chacune,
# distinctes). Déclarées dans le secret store Supabase (jamais dans Vercel).
# À générer via : openssl rand -base64 32
APP_NIR_ENCRYPTION_KEY=
APP_NIR_SEARCH_KEY=

# SMS (Twilio ou OVH SMS Pro)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# OSRM auto-hébergé
OSRM_BASE_URL=http://localhost:5000

# Microservice optimizer (OR-Tools)
OPTIMIZER_BASE_URL=http://localhost:8080

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# NIR validation — hotfix UX 2026-05-15
# When true, NIR validation requires correct INSEE checksum
# (algorithm: 97 - (N mod 97)). When false or unset, only format
# validation (15 digits + structure : sex, month, dept, etc.).
# Default: false (suitable for demo design partner).
# Set to true on Vercel for production deployment.
NEXT_PUBLIC_NIR_CHECKSUM_STRICT=false

# ─── Phase 1.5 — RGPD compliance (server-only, JAMAIS côté client) ───
#
# Ces variables sont consommées par les Server Actions Next.js
# (apps/web), les Edge Functions Supabase et les RPC SECURITY DEFINER.
# Elles NE DOIVENT PAS être préfixées NEXT_PUBLIC_ ni chargées dans le
# bundle client. Stockage : .env.local en dev, Vercel project env en prod
# (secrets serveur uniquement), Supabase secrets pour les RPC/Edge Functions.

# JWT portail patient (D-10) — secret HS256, 32 bytes minimum.
# Sert à signer/vérifier les request_token générés à l'ouverture d'une
# patient_data_request (validité 30 jours alignée DB).
# Générer : openssl rand -base64 32
# Distinct OBLIGATOIREMENT de APP_NIR_ENCRYPTION_KEY (jamais réutiliser).
APP_LEGAL_TOKEN_SECRET=

# Salt anonymisation art. 17 RGPD (Plan 1.5-02 RPC rgpd_anonymize_patient).
# Sert à hasher le NIR via pgcrypto sha256+salt avant UPDATE patients.
# Générer : openssl rand -base64 32
# JAMAIS rotation sans plan migration : les hash NIR anonymisés deviendraient
# incohérents avec les nouveaux hash — perte d'unicité métier irréversible.
APP_ANONYMIZATION_SALT=

# [DIFFÉRÉ ADR-004 / DEC-062] Fournisseur SMS en pause — non requis V1.5.
# Twilio écarté (US/CLOUD Act, inadapté aux données de santé). Le bloc SMS
# ci-dessous (Twilio + cron token) est conservé pour le rebranchement
# futur (cible API SMS française HDS, ou RaspiSMS auto-hébergé).
# À reconfigurer au choix du fournisseur — cf. docs/adr/ADR-004.
#
# Twilio SMS (Phase 05 — rappels patients J-1 et J-2h).
# Numéro expéditeur = numéro pro de la société (E.164, ex: +262XXXXXXXXX).
# Côté serveur uniquement (Server Actions, Route Handlers cron).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cron jobs SMS (Phase 05 — [DIFFÉRÉ ADR-004], cron en pause).
# Token Bearer pour authentifier les Route Handlers /api/cron/sms-reminders-*
# déclenchés par pg_cron via pg_net.http_post (migration Wave 1).
# IMPORTANT : doit matcher exactement le secret Vault Supabase 'cron_app_token'
# créé via : SELECT vault.create_secret('xxx-32-chars', 'cron_app_token');
# Sans cohérence : les Route Handlers retournent 401 (comportement attendu).
# Générer : openssl rand -base64 32
CRON_APP_TOKEN=

# URL publique de l'application (custom domain Vercel ou .vercel.app).
# Utilisé pour :
#   1. statusCallback Twilio (cron J-1/J-2h → packages/sms.sendSms)
#   2. Validation HMAC webhook Twilio (l'URL doit matcher exactement la
#      configuration côté console Twilio Phone Number → Messaging → Webhook).
# Production : https://tap-web-brown.vercel.app
# Dev local : http://localhost:3000 (webhook Twilio inutilisable sans
# tunnel ngrok ; non critique V1.5).
NEXT_PUBLIC_APP_URL=

# Phase 06.20 (DEC-097) — Observabilité Sentry
# DSN public Sentry (côté Vercel : Project Settings → Env Vars).
# Local : laisser vide → init no-op, dev sans Sentry fonctionne.
NEXT_PUBLIC_SENTRY_DSN=
# (Optionnel) DSN serveur si différent du public — sinon réutilise
# NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# Token CI pour upload des source maps (jamais en local).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Phase 10.0 (DEC-096) — Flag prototype géoloc
# Pré-HDS : laisser OFF en prod (0 vraie position persistée).
# En preview démo : 'true' pour activer la capture événementielle.
GEOLOC_ENABLED=

# Phase 06.62 (DEC-141) — Flag échafaudage messagerie (§5.22)
# Release toggle : OFF par défaut (vide) tant que la messagerie complète
# (fil général temps réel, photo, push PWA, non-lus) n'est pas construite.
# 'true' (dev) affiche le point d'accès header + la coquille fil général.
# Évalué côté serveur dans (app)/layout.tsx. Le chat à la course (germe lot 1)
# reste accessible indépendamment du flag.
MESSAGING_ENABLED=

# Phase 06.63 (DEC-143) — Flag échafaudage upload documents conformité
# Release toggle : OFF par défaut (vide) tant que le bucket HDS n'existe pas
# (registre §1.1, Phase 09). OFF = état passif (« Téléversement bientôt
# disponible » / lien « Voir » si url legacy), aucun Storage câblé.
# 'true' (dev) affiche la zone de dépôt ; l'action d'upload est un STUB qui
# échoue (« Storage non configuré ») — pas de faux succès. Évalué côté serveur
# (pages chauffeurs/véhicules/conformité), passé en prop à ComplianceFieldset.
UPLOAD_DOCS_ENABLED=
