# Supabase (local: récupéré après `supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL de connexion Postgres directe (migrations / setup démo) — OVH-05.
# Neutre, prioritaire. Sur Vercel, l'intégration injecte POSTGRES_URL_NON_POOLING
# (repli automatique). Sur OVH / self-host, définir DATABASE_URL.
DATABASE_URL=

# Chiffrement applicatif (NIR, notes médicales) — AES-256-GCM
APP_ENCRYPTION_KEY=

# Edge Function NIR — clés AES-256 + HMAC-SHA256 (32 bytes base64 chacune,
# distinctes). Déclarées dans le secret store Supabase (jamais dans Vercel).
# À générer via : openssl rand -base64 32
APP_NIR_ENCRYPTION_KEY=
APP_NIR_SEARCH_KEY=

# SMS — fournisseur pluggable (OVH-03, ADR-004).
# SMS_PROVIDER : twilio (défaut actuel, comportement inchangé) |
#   sovereign / smsmode / octopush / ovh (cible HDS — adapter à intégrer ;
#   tant que l'intégration n'est pas faite, l'envoi échoue volontairement).
# Absent ou 'twilio' → Twilio, à l'identique.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Web Push PWA chauffeur (DEC-167) — Web Push standard, GRATUIT, pas de provider.
# Générer les clés VAPID une fois : npx web-push generate-vapid-keys
#   → reporter la clé publique dans NEXT_PUBLIC_VAPID_PUBLIC_KEY (exposée au
#     navigateur, OK) et la privée dans VAPID_PRIVATE_KEY (SECRET serveur, jamais
#     exposée). Les deux dans les secrets Vercel.
# VAPID_SUBJECT = mailto: ou URL de contact de la société (défaut interne sinon).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@tap-reunion.re

# OSRM auto-hébergé
OSRM_BASE_URL=http://localhost:5000

# Microservice optimizer (OR-Tools)
OPTIMIZER_BASE_URL=http://localhost:8080

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# NIR validation — hotfix UX 2026-05-15
# When true, NIR validation requires correct INSEE checksum
# (algorithm: 97 - (N mod 97)). When false or unset, only format
# validation (15 digits + structure : sex, month, dept, etc.).
# Default: false (suitable for demo design partner).
# Set to true on Vercel for production deployment.
NEXT_PUBLIC_NIR_CHECKSUM_STRICT=false

# ─── Phase 1.5 — RGPD compliance (server-only, JAMAIS côté client) ───
#
# Ces variables sont consommées par les Server Actions Next.js
# (apps/web), les Edge Functions Supabase et les RPC SECURITY DEFINER.
# Elles NE DOIVENT PAS être préfixées NEXT_PUBLIC_ ni chargées dans le
# bundle client. Stockage : .env.local en dev, Vercel project env en prod
# (secrets serveur uniquement), Supabase secrets pour les RPC/Edge Functions.

# JWT portail patient (D-10) — secret HS256, 32 bytes minimum.
# Sert à signer/vérifier les request_token générés à l'ouverture d'une
# patient_data_request (validité 30 jours alignée DB).
# Générer : openssl rand -base64 32
# Distinct OBLIGATOIREMENT de APP_NIR_ENCRYPTION_KEY (jamais réutiliser).
APP_LEGAL_TOKEN_SECRET=

# Salt anonymisation art. 17 RGPD (Plan 1.5-02 RPC rgpd_anonymize_patient).
# Sert à hasher le NIR via pgcrypto sha256+salt avant UPDATE patients.
# Générer : openssl rand -base64 32
# JAMAIS rotation sans plan migration : les hash NIR anonymisés deviendraient
# incohérents avec les nouveaux hash — perte d'unicité métier irréversible.
APP_ANONYMIZATION_SALT=

# [DIFFÉRÉ ADR-004 / DEC-062] Fournisseur SMS en pause — non requis V1.5.
# Twilio écarté (US/CLOUD Act, inadapté aux données de santé). Le bloc SMS
# ci-dessous (Twilio + cron token) est conservé pour le rebranchement
# futur (cible API SMS française HDS, ou RaspiSMS auto-hébergé).
# À reconfigurer au choix du fournisseur — cf. docs/adr/ADR-004.
#
# Twilio SMS (Phase 05 — rappels patients J-1 et J-2h).
# Numéro expéditeur = numéro pro de la société (E.164, ex: +262XXXXXXXXX).
# Côté serveur uniquement (Server Actions, Route Handlers cron).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Cron jobs SMS (Phase 05 — [DIFFÉRÉ ADR-004], cron en pause).
# Token Bearer pour authentifier les Route Handlers /api/cron/sms-reminders-*
# déclenchés par pg_cron via pg_net.http_post (migration Wave 1).
# IMPORTANT : doit matcher exactement le secret Vault Supabase 'cron_app_token'
# créé via : SELECT vault.create_secret('xxx-32-chars', 'cron_app_token');
# Sans cohérence : les Route Handlers retournent 401 (comportement attendu).
# Générer : openssl rand -base64 32
CRON_APP_TOKEN=

# URL publique de l'application (custom domain Vercel ou .vercel.app).
# Utilisé pour :
#   1. statusCallback Twilio (cron J-1/J-2h → packages/sms.sendSms)
#   2. Validation HMAC webhook Twilio (l'URL doit matcher exactement la
#      configuration côté console Twilio Phone Number → Messaging → Webhook).
# Production : https://tap-web-brown.vercel.app
# Dev local : http://localhost:3000 (webhook Twilio inutilisable sans
# tunnel ngrok ; non critique V1.5).
NEXT_PUBLIC_APP_URL=

# Phase 06.20 (DEC-097) — Observabilité Sentry
# DSN public Sentry (côté Vercel : Project Settings → Env Vars).
# Local : laisser vide → init no-op, dev sans Sentry fonctionne.
NEXT_PUBLIC_SENTRY_DSN=
# (Optionnel) DSN serveur si différent du public — sinon réutilise
# NEXT_PUBLIC_SENTRY_DSN.
SENTRY_DSN=
# Token CI pour upload des source maps (jamais en local).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Environnement applicatif découplé de l'hébergeur (OVH-02).
# Vercel : NE PAS poser (le repli sur VERCEL_ENV s'applique automatiquement).
# OVH / autre : poser APP_ENV = production | staging | development,
# et NEXT_PUBLIC_APP_ENV à la même valeur (le client lit la variante NEXT_PUBLIC_).
APP_ENV=
NEXT_PUBLIC_APP_ENV=

# Phase 10.0 (DEC-096) — Flag prototype géoloc
# Pré-HDS : laisser OFF en prod (0 vraie position persistée).
# En preview démo : 'true' pour activer la capture événementielle.
GEOLOC_ENABLED=

# Phase 06.62 (DEC-141) — Messagerie interne (§5.22) — LIVRÉE
# Périmètre construit et mergé : fil général temps réel (#480), non-lus (#478),
# photo jointe (#479). Désormais ON PAR DÉFAUT (vide = activée). La variable est
# un KILL-SWITCH : poser 'false' pour désactiver en cas d'incident.
# Évalué côté serveur de façon uniforme via lib/release-flags.ts
# (isMessagingEnabled) : point d'accès header + route /messagerie.
# Le chat à la course reste accessible indépendamment.
# Note : le realtime (chat + fil) fonctionne SANS clés VAPID ; les notifications
# push sont un no-op gracieux tant que VAPID n'est pas posé (non bloquant).
MESSAGING_ENABLED=

# Upload des justificatifs de conformité — LIVRÉ (#475)
# Téléversement réel sur Supabase Storage (bucket PRIVÉ `compliance-documents`,
# RLS par organisation, URL signées à la lecture). Désormais ON PAR DÉFAUT
# (vide = activé). La variable est un KILL-SWITCH : poser 'false' pour désactiver.
# En BÊTA, l'upload utilise Supabase Storage EU sous DPA — DEC-077 : le HDS est
# un prérequis de la PROD commerciale, pas de la bêta. La migration du bucket
# vers une infra HDS en prod ne changera pas le code (CON-001, accès Storage
# encapsulé dans lib/storage/compliance-documents.ts).
# Évalué côté serveur de façon uniforme via lib/release-flags.ts
# (isUploadDocsEnabled), passé en prop à ComplianceFieldset (pages
# chauffeurs/véhicules/conformité).
UPLOAD_DOCS_ENABLED=

# Phase 06.64 (DEC-144) — Flag échafaudage notifications email (§5.22)
# Release toggle : OFF par défaut (vide) tant qu'aucun provider n'est choisi
# (registre §1.2). `lib/email/send.ts` est un no-op loggé : OFF → [email:disabled]
# { skipped }, ON → [email:no-provider] { sent:false }. Aucun envoi réel, aucun
# provider installé. Le vrai branchement (Resend/SMTP/…) sera un lot dédié.
EMAIL_ENABLED=

# OVH-05 — Init self-service des données de démo (/setup). OFF par défaut.
# 'true' UNIQUEMENT en dev/démo (sinon le bouton « Initialiser » refuse).
# JAMAIS en production HDS : la base y est provisionnée et migrée par l'équipe,
# pas via ce bouton.
DEMO_SETUP_ENABLED=
